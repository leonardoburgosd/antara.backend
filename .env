# Copia este archivo a .env y ajusta los valores antes de desplegar.
# El archivo .env NO debe subirse al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=antaradb
POSTGRES_USER=postgres
# Cambia esta contraseña en producción. Evita caracteres como ; @ : $ en la
# contraseña, ya que se usa dentro de la cadena de conexión de Npgsql.
POSTGRES_PASSWORD=postgres
# Puerto del host para conectarse a PostgreSQL (solo en 127.0.0.1).
POSTGRES_PORT=5432

# --- Puertos publicados ---
WEB_PORT=80
API_PORT=8081

# --- Biblioteca musical en el host ---
# Windows: usa barras normales, por ejemplo D:/Musica y F:/BibliotecaFLAC.
# Linux/macOS: rutas absolutas como /mnt/musica.
MUSIC_PATH=./music
MUSIC_FLAC_PATH=./music/flac

# Las unidades del host NO se listan aquí: scripts/montar-unidades.sh detecta
# las que existan y genera los montajes de solo lectura (X:/ -> /host/x).
# Punto de montaje usado por la API para traducir rutas de Windows.
HOST_MOUNT_ROOT=/host

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production

# --- Autenticacion ---
# Clave usada para firmar los tokens (HMAC-SHA256). Cambiala en produccion.
# Si la cambias, las sesiones abiertas deberan iniciar sesion nuevamente.
TOKEN_SECRET=antara-cambia-este-secreto-en-produccion
TOKEN_EXPIRACION_HORAS=8

# --- Escaneo de biblioteca y metadatos ---
# Canciones procesadas en paralelo al escanear las rutas de audio.
ESCANEO_AUDIO_MAX_PARALELO=4
# Proveedores publicos (Deezer publico, TheAudioDB key publica 123).
DEEZER_API_BASE=https://api.deezer.com
DEEZER_HABILITADO=true
DEEZER_PRIORIDAD=0
THEAUDIODB_API_BASE=https://www.theaudiodb.com/api/v1/json/123
THEAUDIODB_API_KEY=123
THEAUDIODB_HABILITADO=true
THEAUDIODB_PRIORIDAD=1
LETRAS_API_BASE=https://api.lyrics.ovh
LETRAS_HABILITADO=true
METADATOS_TIMEOUT_SEGUNDOS=20

# --- Zona horaria ---
TZ=UTC

# --- Tailscale (acceso remoto al panel) ---
# Pegá acá la auth key (tskey-auth-...). Se genera en
# https://login.tailscale.com/admin/settings/keys con "Reusable" y "Ephemeral"
# desmarcado. Si la dejás vacía, el perfil tailscale no se inicia.
TAILSCALE_AUTHKEY=tskey-auth-kFK3AR2E7v11CNTRL-VGJiuuEFQJc3JAD4YcneJcfT1f6NEpCZK
# Nombre del nodo dentro del tailnet (https://<hostname>.<tailnet>.ts.net).
TAILSCALE_HOSTNAME=antara
# Archivo de "tailscale serve". Vacío = solo IP del tailnet, sin HTTPS.
TAILSCALE_SERVE_MODE=http
TAILSCALE_SERVE_URL=http://web:80
TAILSCALE_EXTRA_ARGS=
SUBUDA_AUDIO_MAX_MB=2048
YTDLP_PLAYER_CLIENT=android
YTDLP_COOKIES_PATH=/config/cookies/youtube.txt
MUSICBRAINZ_API_BASE=https://musicbrainz.org
MUSICBRAINZ_HABILITADO=true
MUSICBRAINZ_PRIORIDAD=2
ITUNES_API_BASE=https://itunes.apple.com
ITUNES_HABILITADO=true
ITUNES_PRIORIDAD=3
