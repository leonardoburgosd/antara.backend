# Copia este archivo a .env y ajusta los valores antes de desplegar.
# El archivo .env NO debe subirse al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=antaradb
POSTGRES_USER=postgres
# Cambia esta contraseña en producción. Evita caracteres como ; @ : $ en la
# contraseña, ya que se usa dentro de la cadena de conexión de Npgsql.
POSTGRES_PASSWORD=postgres
# Puerto del host para conectarse a PostgreSQL (solo en 127.0.0.1).
POSTGRES_PORT=5432

# --- Puertos publicados ---
WEB_PORT=80
API_PORT=8080

# --- Biblioteca musical en el host ---
# Windows: usa barras normales, por ejemplo D:/Musica y F:/BibliotecaFLAC.
# Linux/macOS: rutas absolutas como /mnt/musica.
MUSIC_PATH=./music
MUSIC_FLAC_PATH=./music/flac

# Las unidades del host no se declaran a mano: scripts/montar-unidades.sh
# detecta las que existan y las monta en /host/<letra> (C:/ -> /host/c).
# Se montan con escritura porque el panel sube canciones a esas carpetas; usa
# UNIDADES_SOLO_LECTURA=1 al ejecutar el script si no quieres permitirlo.
# Punto de montaje usado por la API para traducir rutas de Windows.
HOST_MOUNT_ROOT=/host

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production

# --- Autenticacion ---
# Clave usada para firmar los tokens (HMAC-SHA256). Cambiala en produccion.
# Si la cambias, las sesiones abiertas deberan iniciar sesion nuevamente.
TOKEN_SECRET=antara-cambia-este-secreto-en-produccion
TOKEN_EXPIRACION_HORAS=8

# --- Escaneo de biblioteca y metadatos ---
# Canciones procesadas en paralelo al escanear las rutas de audio.
ESCANEO_AUDIO_MAX_PARALELO=4
# Proveedores de metadatos. La lista de proveedores vive en docker-compose.yml
# (AppSettings__MetadatosProveedores__N__*); aquí se ajustan sus valores.
# Deshabilita uno con *_HABILITADO=false y cambia el orden con *_PRIORIDAD
# (menor se consulta primero).
DEEZER_API_BASE=https://api.deezer.com
DEEZER_HABILITADO=true
DEEZER_PRIORIDAD=0
THEAUDIODB_API_BASE=https://www.theaudiodb.com/api/v1/json/123
THEAUDIODB_API_KEY=123
THEAUDIODB_HABILITADO=true
THEAUDIODB_PRIORIDAD=1
# MusicBrainz (sin clave; 1 peticion/segundo) con portadas de Cover Art Archive.
MUSICBRAINZ_API_BASE=https://musicbrainz.org
MUSICBRAINZ_HABILITADO=true
MUSICBRAINZ_PRIORIDAD=2
# iTunes Search API (sin clave; ~20 peticiones/minuto).
ITUNES_API_BASE=https://itunes.apple.com
ITUNES_HABILITADO=true
ITUNES_PRIORIDAD=3
# LRCLIB (sin clave; letras planas/sincronizadas, album y duracion).
LRCLIB_API_BASE=https://lrclib.net
LRCLIB_HABILITADO=true
LRCLIB_PRIORIDAD=4
# Alternativa: define la lista completa en una sola variable (JSON) y se ignora
# lo anterior. Sirve para agregar un proveedor sin editar docker-compose.yml:
# METADATOS_PROVEEDORES_JSON=[{"Nombre":"deezer","Etiqueta":"Deezer","Tipo":"deezer","BaseUrl":"https://api.deezer.com","Prioridad":0,"Habilitado":true},{"Nombre":"deezer-alt","Etiqueta":"Deezer (espejo)","Tipo":"deezer","BaseUrl":"https://api.deezer.com","Prioridad":1,"Habilitado":true}]
METADATOS_PROVEEDORES_JSON=
# Proveedor de letras (opcional).
LETRAS_API_BASE=https://api.lyrics.ovh
LETRAS_HABILITADO=true
METADATOS_TIMEOUT_SEGUNDOS=20

# --- Subida de canciones ---
# Tamaño máximo (MB) de cada archivo de audio subido desde el panel.
SUBUDA_AUDIO_MAX_MB=2048
# Descarga desde YouTube. La imagen incluye yt-dlp y ffmpeg; ajusta solo si
# montas otro binario o necesitas más tiempo para videos largos.
YTDLP_PATH=yt-dlp
DESCARGA_YOUTUBE_TIMEOUT_SEGUNDOS=600
# Cliente interno de YouTube usado por yt-dlp. "android" evita el bloqueo
# "Sign in to confirm you're not a bot"; proba "tv" o vacío si falla.
YTDLP_PLAYER_CLIENT=android
# Cookies (formato Netscape) si YouTube pide sesión. El archivo se monta desde
# ./cookies/youtube.txt y se ignora si no existe.
YTDLP_COOKIES_PATH=/config/cookies/youtube.txt

# --- Tailscale (acceso remoto al panel) ---
# Auth key del tailnet: https://login.tailscale.com/admin/settings/keys
# (Reusable, sin Ephemeral). Si queda vacía, el perfil "tailscale" no arranca.
# Uso: docker compose --profile tailscale up -d
TAILSCALE_AUTHKEY=
# Nombre del nodo: https://<TAILSCALE_HOSTNAME>.<tu-tailnet>.ts.net
TAILSCALE_HOSTNAME=antara
# Cómo publica el panel en el tailnet: http (puerto 80, sin certificados),
# https (puerto 443, requiere HTTPS habilitado en el tailnet) o ninguno.
TAILSCALE_SERVE_MODE=http
# Destino interno que se publica (el contenedor web de Nginx).
TAILSCALE_SERVE_URL=http://web:80
# Argumentos extra para tailscaled, por ejemplo: --advertise-tags=tag:antara
TAILSCALE_EXTRA_ARGS=

# --- Zona horaria ---
TZ=UTC
